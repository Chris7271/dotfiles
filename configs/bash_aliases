# ============================================
# 自定义 Shell 别名（macOS / Linux 通用）
# ============================================

# ls 增强别名（macOS 用 -G 启用颜色，Linux 用 --color=auto）
if [[ "$(uname)" == "Darwin" ]]; then
    alias ll='ls -lFG'
    alias lla='ls -alFG'
    alias llh='ls -alFhG'
    alias la='ls -AhG'
    alias l='ls -CFhG'
else
    alias ll='ls -lF --color=auto'
    alias lla='ls -alF --color=auto'
    alias llh='ls -alFh --color=auto'
    alias la='ls -Ah --color=auto'
    alias l='ls -CFh --color=auto'
fi

# Claude Code
alias claude='claude --dangerously-skip-permissions'

# tmux 快捷别名
alias ta='tmux attach'
alias tat='tmux attach -t'
alias tl='tmux ls'
alias tn='tmux new -s'
alias tk='tmux kill-session -t'
alias td='tmux detach'
alias ts='tmux switch-client -t'

# Vim + Markdown 快捷别名
alias mdp='glow -p'
alias mde='tmux new -s md vim'

# 导航别名
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias cls='clear'

# Git 别名
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline -10'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
